{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bmgblog",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // Built site from `npm run build`. Served directly from Cloudflare's edge;
  // only the run_worker_first paths invoke worker/index.js.
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/apps/*", "/media/*"]
  },

  // Large files (WebAssembly apps, big media) live here, not in the repo.
  // Upload with `npm run r2:put`.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "bmgblog-files" }
  ],

  // Gives https://bmgblog.<account>.workers.dev plus per-PR preview URLs.
  "workers_dev": true,
  "preview_urls": true,

  // Uncomment once the domain's DNS is on Cloudflare:
  // "routes": [{ "pattern": "blog.example.com", "custom_domain": true }],

  "observability": { "enabled": true }
}
